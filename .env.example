DB_HOST=localhost
DB_PORT=5432
DB_NAME=fastapi_learning
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_ECHO=false

API_KEY_PEPPER=replace_with_a_secure_random_value
API_KEY_MAX_ACTIVE_PER_USER=10

# AWS / SQS
AWS_REGION=replace_with_aws_region
SQS_JOBS_QUEUE_URL=replace_with_jobs_queue_url

AWS_CONNECT_TIMEOUT_SECONDS=2
AWS_READ_TIMEOUT_SECONDS=5
AWS_TOTAL_MAX_ATTEMPTS=3